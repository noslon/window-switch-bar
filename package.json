{
  "name": "window-switch-bar",
  "displayName": "Window Switch Bar",
  "description": "Jump between open VS Code windows in one click from the status bar.",
  "version": "1.0.0",
  "publisher": "noslon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noslon/window-switch-bar.git"
  },
  "bugs": {
    "url": "https://github.com/noslon/window-switch-bar/issues"
  },
  "homepage": "https://github.com/noslon/window-switch-bar#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0078D4",
    "theme": "dark"
  },
  "keywords": [
    "window",
    "windows",
    "switch",
    "switcher",
    "jump",
    "multi-window",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Window Switch Bar only reads window names and folder paths. It never runs or reads workspace code."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "windowswitchbar.positionLeft",
        "title": "Show on Left",
        "category": "Window Switch Bar"
      },
      {
        "command": "windowswitchbar.positionRight",
        "title": "Show on Right",
        "category": "Window Switch Bar"
      },
      {
        "command": "windowswitchbar.displayDropdown",
        "title": "Show as Dropdown",
        "category": "Window Switch Bar"
      },
      {
        "command": "windowswitchbar.displayButtons",
        "title": "Show as Buttons",
        "category": "Window Switch Bar"
      }
    ],
    "configuration": {
      "title": "Window Switch Bar",
      "properties": {
        "windowswitchbar.display": {
          "type": "string",
          "default": "buttons",
          "enum": [
            "buttons",
            "dropdown"
          ],
          "enumDescriptions": [
            "One status bar entry per window. Click one to switch to that window.",
            "One status bar entry with the current window name. Click it to pick a window from a list."
          ],
          "description": "How Window Switch Bar shows windows in the status bar."
        },
        "windowswitchbar.position": {
          "type": "string",
          "default": "left",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Show Window Switch Bar on the left side of the status bar.",
            "Show Window Switch Bar on the right side of the status bar."
          ],
          "description": "Which side of the status bar Window Switch Bar uses."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "install-extension": "npm run package && code --install-extension window-switch-bar-$npm_package_version.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.4.5"
  }
}
